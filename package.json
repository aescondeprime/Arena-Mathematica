{
  "name": "arena-mathematica",
  "version": "0.1.0",
  "productName": "Arena Mathematica",
  "description": "An adaptive mathematical reasoning arena for training problem-solving, working-memory manipulation, and transfer.",
  "license": "MIT",
  "private": false,
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "desktop:dev": "npm run build && electron .",
    "build": "tsc -b && vite build",
    "check": "tsc -b --pretty false",
    "dist:mac": "npm run build && electron-builder --mac --arm64",
    "dist:mac:dir": "npm run build && electron-builder --mac --arm64 --dir"
  },
  "dependencies": {
    "@vitejs/plugin-react": "^4.7.0",
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "vite": "^7.3.0"
  },
  "devDependencies": {
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.1",
    "electron": "^41.7.1",
    "electron-builder": "^26.15.3",
    "typescript": "^5.6.3"
  },
  "build": {
    "appId": "com.aesconde.arenamathematica",
    "productName": "Arena Mathematica",
    "asar": true,
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "mac": {
      "category": "public.app-category.education",
      "target": [
        {
          "target": "dmg",
          "arch": ["arm64"]
        },
        {
          "target": "zip",
          "arch": ["arm64"]
        }
      ],
      "artifactName": "Arena-Mathematica-${version}-${arch}.${ext}"
    }
  }
}
